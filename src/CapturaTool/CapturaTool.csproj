<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Escalado por monitor: sin esto, con 125-150 % la captura sale borrosa o desfasada (NF4) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Publicación: un solo .exe que usa el .NET instalado (NF7, ADR 0003) -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Compilación anticipada para que el editor abra rápido la primera vez (NF2) -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Logo (R33): ícono del .exe (Explorador, barra de tareas) y copia dentro del programa para cargarlo desde el código -->
  <PropertyGroup>
    <ApplicationIcon>Resources\CapturaTool.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\CapturaTool.ico" LogicalName="CapturaTool.ico" />
  </ItemGroup>

</Project>

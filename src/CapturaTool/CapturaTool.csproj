<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Escalado por monitor: sin esto, con 125-150 % la captura sale borrosa o desfasada (NF4) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Publicación: un solo .exe que usa el .NET instalado (NF7, ADR 0003) -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Compilación anticipada para que el editor abra rápido la primera vez (NF2) -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Logo (R33): ícono del .exe (Explorador, barra de tareas) y copia dentro del programa para cargarlo desde el código.
       Se guardan los dos logos (estable e Insider) para que las pruebas puedan revisar ambos. -->
  <PropertyGroup>
    <ApplicationIcon>Resources\CapturaTool.ico</ApplicationIcon>
    <Product>CapturaTool</Product>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\CapturaTool.ico" LogicalName="CapturaTool.ico" />
    <EmbeddedResource Include="Resources\CapturaTool.Insider.ico" LogicalName="CapturaTool.Insider.ico" />
  </ItemGroup>

  <!-- Versión Insider (R34, ADR 0004): dotnet publish ... -p:Channel=Insider
       Cambia solo la identidad: nombre del .exe, nombre del producto (lo muestran los avisos), logo y la constante INSIDER. -->
  <PropertyGroup Condition="'$(Channel)' == 'Insider'">
    <AssemblyName>CapturaTool.Insider</AssemblyName>
    <Product>CapturaTool Insider</Product>
    <AssemblyTitle>CapturaTool Insider</AssemblyTitle>
    <ApplicationIcon>Resources\CapturaTool.Insider.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);INSIDER</DefineConstants>
  </PropertyGroup>

</Project>
